        {
          "name": "PUT Ubah Kost",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Data berhasil diubah', () => {",
                  "  pm.expect(body.nama).to.eql('Kost Musi Raya Updated');",
                  "  pm.expect(body.harga).to.eql('1200000');",
                  "});",
                  "pm.test('_id tidak berubah', () => pm.expect(body._id).to.eql(pm.environment.get('kostId')));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Kost Musi Raya Updated\",\n  \"lokasi\": \"KM 7, Palembang\",\n  \"harga\": \"1200000\",\n  \"status\": \"tersedia\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/kost/{{kostId}}",
