{
  "info": {
    "name": "PAWII - API Kost Data Modeling (MongoDB & Express)",
    "description": "Pengujian otomatis API Kost Pertemuan 9-12. Menguji seluruh endpoint CRUD, filtering, pagination, sorting, projection, serta penanganan error terpusat.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Kost",
      "item": [
        {
          "name": "POST Tambah Kost",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 201', () => pm.response.to.have.status(201));",
                  "const body = pm.response.json();",
                  "pm.test('Response memiliki _id', () => pm.expect(body).to.have.property('_id'));",
                  "pm.test('Data tersimpan dengan benar', () => {",
                  "  pm.expect(body.nama).to.eql('Kost Musi Raya');",
                  "  pm.expect(body.lokasi).to.eql('KM 7, Palembang');",
                  "  pm.expect(body.harga).to.eql('1000000');",
                  "  pm.expect(body.status).to.eql('tersedia');",
                  "});",
                  "pm.environment.set('kostId', body._id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nama\": \"Kost Musi Raya\",\n  \"lokasi\": \"KM 7, Palembang\",\n  \"harga\": \"1000000\",\n  \"status\": \"tersedia\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/kost",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "kost"
              ]
            }
          }
        },
        {
          "name": "POST Tambah Kost - Validasi Gagal",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 400', () => pm.response.to.have.status(400));",
                  "pm.test('Response memiliki pesan error', () => pm.expect(pm.response.json()).to.have.property('message'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"tersedia\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/kost",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "kost"
              ]
            }
          }
        },
        {
          "name": "GET Semua Kost (dengan Pagination & Filter)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('Response memiliki struktur pagination', () => {",
                  "  pm.expect(body).to.have.property('data');",
                  "  pm.expect(body).to.have.property('page');",
                  "  pm.expect(body).to.have.property('limit');",
                  "  pm.expect(body).to.have.property('total');",
                  "  pm.expect(body.data).to.be.an('array');",
                  "});",
                  "pm.test('Berisi kost yang baru dibuat', () => {",
                  "  pm.expect(body.data.map(k => k._id)).to.include(pm.environment.get('kostId'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/kost?page=1&limit=10&sort=-createdAt",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "kost"
              ],
              "query": [
                {
                  "key": "page",
                  "value": "1"
                },
                {
                  "key": "limit",
                  "value": "10"
                },
                {
                  "key": "sort",
                  "value": "-createdAt"
                }
              ]
            }
          }
        },
        {
          "name": "GET Kost Tersedia",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "const listData = body.data || body;",
                  "pm.test('Response berupa list/array data', () => pm.expect(listData).to.be.an('array'));",
                  "pm.test('Semua data berstatus tersedia', () => {",
                  "  listData.forEach(k => pm.expect(k.status.toLowerCase()).to.eql('tersedia'));",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/kost/tersedia",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "kost",
                "tersedia"
              ]
            }
          }
        },
        {
          "name": "GET Satu Kost",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('_id sesuai', () => pm.expect(body._id).to.eql(pm.environment.get('kostId')));",
                  "pm.test('Memiliki struktur data lengkap', () => {",
                  "  pm.expect(body).to.have.property('nama');",
                  "  pm.expect(body).to.have.property('lokasi');",
                  "  pm.expect(body).to.have.property('harga');",
                  "  pm.expect(body).to.have.property('status');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
